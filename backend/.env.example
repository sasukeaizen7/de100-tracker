# Copy to .env and adjust. Everything except JWT_SECRET has a dev default.
PORT=3000
NODE_ENV=development

# PostgreSQL connection. Leave empty to use the embedded PGlite database in ./.data (dev only).
DATABASE_URL=

# 32+ random bytes, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Where the web app runs. Emails link here; CORS allows it.
WEB_ORIGIN=http://localhost:5173
# Public base URL of this API as the browser sees it (through the Vite/Vercel proxy).
API_PUBLIC_URL=http://localhost:5173/api
# Comma-separated Chrome extension IDs allowed to sign in.
EXTENSION_IDS=


# Optional Google sign-in (OAuth client of type "Web application").
# Authorized redirect URI: ${API_PUBLIC_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
